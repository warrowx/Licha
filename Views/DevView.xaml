<UserControl x:Class="GachaLife.Views.DevView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Режим разработчика" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Виден только в отладочной сборке, в релизе скрыт."
                   Style="{StaticResource MutedText}" Margin="0,4,0,24"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Гемы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="+100" Style="{StaticResource AccentButton}"
                            Command="{Binding AddGemsCommand}" CommandParameter="100"/>
                    <Button Content="+1000" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Command="{Binding AddGemsCommand}" CommandParameter="1000"/>
                    <Button Content="-100" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Command="{Binding AddGemsCommand}" CommandParameter="-100"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding GemsInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SetGemsCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Установить" Margin="12,0,0,0"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding SetGemsCommand}"/>
                </Grid>

                <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="2,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>