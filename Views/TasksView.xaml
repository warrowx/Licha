<UserControl x:Class="GachaLife.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="Задачи" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding TodayText}" Style="{StaticResource MutedText}" Margin="0,4,0,24"/>

            <!-- Новая задача -->
            <TextBlock Text="Новая задача" Style="{StaticResource MutedText}" Margin="2,0,0,6"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Добавить" Margin="12,0,0,0"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding AddTaskCommand}"/>
            </Grid>

            <!-- Тип и сложность -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <CheckBox Style="{StaticResource Chip}" Content="Ежедневная"
                          IsChecked="{Binding NewTaskIsDaily}" Margin="0,0,24,0"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Difficulty"
                             Content="Лёгкая +10 ◆" IsChecked="{Binding IsEasy}"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Difficulty"
                             Content="Средняя +20 ◆" IsChecked="{Binding IsMedium}"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Difficulty"
                             Content="Сложная +40 ◆" IsChecked="{Binding IsHard}"/>
            </StackPanel>

            <!-- Пустое состояние -->
            <TextBlock Text="Пока нет задач. Добавьте первую выше.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Список задач -->
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Style="{StaticResource RoundCheck}" VerticalAlignment="Center"
                                          IsChecked="{Binding IsDone, Mode=TwoWay}"/>

                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{StaticResource GoldSoftBrush}"
                                        CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RewardText}"
                                               Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"/>
                                </Border>

                                <Button Grid.Column="3" Content="✕" Margin="10,0,0,0"
                                        Style="{StaticResource IconButton}"
                                        Command="{Binding DeleteCommand}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>